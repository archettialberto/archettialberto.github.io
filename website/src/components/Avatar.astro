---
// The original portrait, with an initials fallback when PHOTO is unset.
import { PHOTO, base } from '../config';
interface Props { name: string }
const { name } = Astro.props;
const initials = name.split(/\s+/).map((w) => w[0]).join('');
---
<div class="portrait">
  {PHOTO
    ? <img src={`${base}${PHOTO}`} alt={name} width="600" height="600" fetchpriority="high" decoding="async" />
    : <div class="portrait-initials"
           role="img" aria-label={name}>
        <span>{initials}</span>
      </div>}
</div>
