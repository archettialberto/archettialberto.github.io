---
// Both language routes render the same YAML/BibTeX-backed page.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Section from './Section.astro';
import Collapsible from './Collapsible.astro';
import Entry from './Entry.astro';
import Avatar from './Avatar.astro';
import LifeBackground from './LifeBackground.astro';
import Publications from './Publications.astro';
import { base } from '../config';
import { cv, cvPdfPath, type Detail } from '../data/cv';
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { ui, tr, period, date } = useTranslations(lang);
const { profile, research_interests, employment, education, courses, talks,
        supervision, awards, projects, publications, news } = cv;
const socials = profile.contacts.filter((contact) => contact.website && contact.url);
const email = socials.find((contact) => contact.icon === 'email');
const scholar = socials.find((contact) => contact.icon === 'scholar');
const github = socials.find((contact) => contact.icon === 'github');
const bioParas = tr(profile.bio ?? profile.summary).trim().split(/\n\s*\n/);
const more = (folded: boolean) => folded ? '' : undefined;
const SHOW = 4;
type Step = {
  kind: 'work' | 'edu'; title: string; start: number; end: number | 'present';
  meta: (string | null)[]; details: Detail[]; thesis: string | null;
};
const degrees = new Set(education.map((entry) => entry.degree));
const timeline: Step[] = [
  ...employment.filter((entry) => !degrees.has(entry.role)).map((entry): Step => ({
    kind: 'work', title: entry.role, start: entry.start, end: entry.end,
    meta: [entry.org, tr(entry.location)], details: entry.details, thesis: null,
  })),
  ...education.map((entry): Step => ({
    kind: 'edu', title: entry.degree, start: entry.start, end: entry.end,
    meta: [entry.org, tr(entry.grade)], thesis: entry.thesis,
    details: employment.find((job) => job.role === entry.degree)?.details ?? [],
  })),
].sort((a, b) => {
  const end = (step: Step) => step.end === 'present' ? Infinity : step.end;
  return end(b) - end(a) || b.start - a.start;
});
const teachingHours = courses.reduce((sum, course) => sum + course.hours, 0);
const talkCountries = new Set(talks.map((talk) => talk.location?.split(',').pop()?.trim()).filter(Boolean)).size;
---
<Base lang={lang}>
  <a class="skip-link" href="#main">{ui.skip}</a>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <div class="introduction">
      <LifeBackground />
      <section id="hero" class="hero page-width" aria-labelledby="hero-title">
        <div class="hero-profile">
          <Avatar name={profile.name} />
          <div class="hero-intro">
            <h1 id="hero-title" class="hero-name">{profile.name}</h1>
            <p class="hero-role">{tr(profile.title)}</p>
            {profile.affiliation && <p class="hero-affiliation">{tr(profile.affiliation)}</p>}
            <div class="profile-links">
              {email?.url && <a href={email.url}>{email.label}</a>}
              {scholar?.url && <a href={scholar.url} target="_blank" rel="noopener">Google Scholar</a>}
              {github?.url && <a href={github.url} target="_blank" rel="noopener">{github.label}</a>}
            </div>
          </div>
        </div>
        <p class="hero-summary">{tr(profile.summary)}</p>
        <div class="hero-actions">
          <a href={`${base}${cvPdfPath}`} target="_blank" rel="noopener" class="button button-primary">{ui.downloadCv}<span aria-hidden="true">↗</span></a>
          {publications.length > 0 && <a href="#publications" class="text-link">{ui.readResearch}</a>}
        </div>
      </section>
    </div>
    <div class="page-width">
      <Section id="about" title={ui.about}>
        <div class="bio">{bioParas.map((paragraph) => <p set:html={paragraph} />)}</div>
        {profile.quote && (
          <figure class="epigraph">
            <blockquote>“{tr(profile.quote.text)}”</blockquote>
            <figcaption>{profile.quote.author}{profile.quote.source && <>, <cite>{profile.quote.source}</cite></>}</figcaption>
          </figure>
        )}
      </Section>
    </div>
    {research_interests.length > 0 && (
      <div class="research-field">
        <Section id="research" title={ui.research} class="page-width">
          <div class="research-list">
            {research_interests.map((interest) => (
              <article>
                <h3>{tr(interest.title)}</h3>
                {interest.description && <p>{tr(interest.description)}</p>}
              </article>
            ))}
          </div>
        </Section>
      </div>
    )}
    <div class="page-width">
      {news.length > 0 && (
        <Section id="news" title={ui.news}>
          <ol class="news-list">
            {news.slice(0, SHOW).map((item) => (
              <li>
                <time datetime={item.date}>{date(item.date)}</time>
                <p set:html={tr(item.text)} />
              </li>
            ))}
          </ol>
        </Section>
      )}
      {publications.length > 0 && <Publications lang={lang} />}
      <Section id="experience" title={ui.experience}>
        <Collapsible total={timeline.length} hidden={timeline.length - SHOW} showAll={ui.showAll} showFewer={ui.showFewer}>
          <ol class="experience-list">
            {timeline.map((step, i) => (
              <li data-more={more(i >= SHOW)}>
                <p class="entry-kind">{step.kind === 'work' ? ui.work : ui.education}</p>
                <Entry title={tr(step.title)} year={period(step.start, step.end)} meta={step.meta}>
                  {step.details.map((detail) => <p class="entry-detail"><span>{tr(detail.label)}:</span> {tr(detail.text)}</p>)}
                  {step.thesis && <p class="entry-detail"><span>{ui.thesis}:</span> <em>{step.thesis}</em></p>}
                </Entry>
              </li>
            ))}
          </ol>
        </Collapsible>
        {projects.length > 0 && (
          <div class="projects-block">
            <h3 class="subsection-title">{ui.projects}</h3>
            {projects.map((project) => (
              <article class="project">
                <h4>{project.url ? <a href={project.url} target="_blank" rel="noopener">{project.name}</a> : project.name}</h4>
                {project.full_name && <p>{project.full_name}</p>}
                <p class="entry-meta">{period(project.start, project.end)} · {[project.issuer, project.scope ? `${project.scope} ${ui.project}` : null].filter(Boolean).join(' · ')}</p>
                <p>{tr(project.role)}</p>
                {project.description && <p>{tr(project.description)}</p>}
              </article>
            ))}
          </div>
        )}
      </Section>
    </div>
    {(courses.length > 0 || supervision.length > 0) && (
      <div class="teaching-field">
        <Section id="teaching" title={ui.teaching} class="page-width">
          <Fragment slot="aside"><p>{ui.coursesMeta(courses.length, teachingHours)}</p><p>{ui.supervisionMeta(supervision.length)}</p></Fragment>
          <div class="teaching-columns">
            {courses.length > 0 && (
              <div>
                <h3 class="subsection-title">{ui.courses}</h3>
                <Collapsible total={courses.length} hidden={courses.length - 4} showAll={ui.showAll} showFewer={ui.showFewer}>
                  <div class="entry-list">
                    {courses.map((course, i) => (
                      <Entry heading="h4" data-more={more(i >= 4)} title={tr(course.course)} year={period(course.start, course.end)} meta={[tr(course.degree), course.org]}>
                        <p class="entry-detail">{tr(course.role)}{course.editions > 1 && <> · {ui.editions(course.editions)}</>}</p>
                      </Entry>
                    ))}
                  </div>
                </Collapsible>
              </div>
            )}
            {supervision.length > 0 && (
              <div>
                <h3 class="subsection-title">{ui.supervision}</h3>
                <Collapsible total={supervision.length} hidden={supervision.length - 3} showAll={ui.showAll} showFewer={ui.showFewer}>
                  <div class="entry-list">
                    {supervision.map((student, i) => (
                      <Entry heading="h4" data-more={more(i >= 3)} title={student.student} year={student.year} meta={[tr(student.degree), tr(student.role)]}>
                        <p class="entry-detail">{student.title}</p>
                      </Entry>
                    ))}
                  </div>
                </Collapsible>
              </div>
            )}
          </div>
        </Section>
      </div>
    )}
    <div class="page-width">
      {talks.length > 0 && (
        <Section id="talks" title={ui.talks}>
          <Fragment slot="aside">{ui.talksMeta(talks.length, talkCountries)}</Fragment>
          <Collapsible total={talks.length} hidden={talks.length - SHOW} showAll={ui.showAll} showFewer={ui.showFewer}>
            <ol class="talk-list">
              {talks.map((talk, i) => (
                <li data-more={more(i >= SHOW)}>
                  <time datetime={String(talk.year)}>{talk.year}</time>
                  <div>
                    <h3>{talk.url ? <a href={talk.url} target="_blank" rel="noopener">{talk.title}</a> : talk.title}</h3>
                    <p>{tr(talk.event)}</p>
                    <p class="entry-meta">{[tr(talk.kind), tr(talk.location)].filter(Boolean).join(' · ')}</p>
                  </div>
                </li>
              ))}
            </ol>
          </Collapsible>
        </Section>
      )}
      {awards.length > 0 && (
        <Section id="awards" title={ui.awards}>
          <dl class="award-list">
            {awards.map((award) => (
              <div>
                <dt>{tr(award.title)}</dt>
                <dd>{[award.year, award.org, tr(award.note)].filter(Boolean).join(' · ')}</dd>
              </div>
            ))}
          </dl>
        </Section>
      )}
    </div>
  </main>
  <footer id="contact" class="site-footer">
    <div class="page-width">
      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <nav aria-label={ui.contact}>
          {socials.map((contact) => <a href={contact.url!} target={contact.icon === 'email' ? undefined : '_blank'} rel="noopener">{contact.label}</a>)}
        </nav>
        <a href="#hero">{ui.backTop}</a>
      </div>
    </div>
  </footer>
</Base>
