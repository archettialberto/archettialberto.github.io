---
// One shared reading column, with context and links beside the heading.
interface Props { id?: string; title?: string; class?: string }
const { id, title, class: cls = '' } = Astro.props;
---
<section id={id} class={`section ${cls}`} aria-labelledby={title && id ? `${id}-title` : undefined}>
  {title && (
    <header class="section-heading">
      <h2 id={id ? `${id}-title` : undefined}>{title}</h2>
      {Astro.slots.has('aside') && <div class="section-aside"><slot name="aside" /></div>}
    </header>
  )}
  <div class="section-content"><slot /></div>
</section>
