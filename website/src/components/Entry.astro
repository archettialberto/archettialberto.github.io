---
// A readable entry used by the YAML-backed academic lists.
// Extra attributes (class, data-*) land on the wrapper.
interface Props {
  title: string;
  year?: number | string | null;
  meta?: (string | number | null | undefined)[];
  class?: string;
  heading?: 'h3' | 'h4';
  [attr: `data-${string}`]: string | undefined;
}
const { title, year, meta = [], class: cls, heading: Heading = 'h3', ...attrs } = Astro.props;
const metaLine = meta.filter(Boolean).join(' · ');
---
<div class:list={['entry', cls]} {...attrs}>
  <Heading>{title}</Heading>
  {(year || metaLine) && (
    <div class="entry-meta">
      {year && <span class="entry-year">{year}</span>}
      {metaLine && <span>{metaLine}</span>}
    </div>
  )}
  <slot />
</div>
